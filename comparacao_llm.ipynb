# Célula 1: Instalação das dependências
# Estamos usando bitsandbytes para quantização (rodar modelos pesados em GPUs menores)
!pip install -q -U transformers accelerate bitsandbytes sentencepiece

# Célula 2: Importação e Configuração
import torch
import time
import pandas as pd
from transformers import AutoTokenizer, AutoModelForCausalLM, BitsAndBytesConfig
from huggingface_hub import login

# --- IMPORTANTE: COLE SEU TOKEN DO HUGGING FACE ABAIXO ---
# O Gemma é um modelo "gated", precisa de autenticação.
login(token="SEU_TOKEN_HUGGING_FACE_AQUI")

# Configuração para rodar em 4-bits (economiza memória da GPU)
bnb_config = BitsAndBytesConfig(
    load_in_4bit=True,
    bnb_4bit_use_double_quant=True,
    bnb_4bit_quant_type="nf4",
    bnb_4bit_compute_dtype=torch.bfloat16
)

# Lista de Modelos para Comparação
models_to_compare = [
    "google/gemma-2b-it",    # Modelo leve (2B)
    "mistralai/Mistral-7B-Instruct-v0.2" # Modelo médio (7B) - Versão Instruct é melhor para chat
]

# Perguntas de Teste (Benchmarks simplificados)
prompts = [
    "Explique o conceito de 'Recursividade' em Python em uma frase.",
    "Crie uma função simples em SQL para calcular a média de vendas.",
    "Qual é a capital da França? Responda apenas com o nome."
]

results = []

# Célula 3: Execução e Comparação
print("Iniciando Benchmark...\n")

for model_id in models_to_compare:
    print(f"Carregando modelo: {model_id}...")
    
    # Carrega Tokenizer e Modelo
    tokenizer = AutoTokenizer.from_pretrained(model_id)
    model = AutoModelForCausalLM.from_pretrained(
        model_id, 
        quantization_config=bnb_config, 
        device_map="auto"
    )
    
    print(f"Modelo {model_id} carregado. Gerando respostas...")
    
    for prompt in prompts:
        # Formatação simples de chat para modelos instruct
        if "gemma" in model_id:
            formatted_prompt = f"<start_of_turn>user\n{prompt}<end_of_turn>\n<start_of_turn>model"
        else: # Mistral
            formatted_prompt = f"[INST] {prompt} [/INST]"
            
        inputs = tokenizer(formatted_prompt, return_tensors="pt").to("cuda")
        
        # Medindo tempo de inferência
        start_time = time.time()
        outputs = model.generate(**inputs, max_new_tokens=100)
        end_time = time.time()
        
        response = tokenizer.decode(outputs[0], skip_special_tokens=True)
        
        # Limpeza básica da resposta (remove o prompt original da saída)
        clean_response = response.replace(formatted_prompt, "").strip()
        # Ajuste extra para o Gemma que as vezes repete o prompt no decode
        if "user\n" in clean_response: 
            clean_response = clean_response.split("model")[-1].strip()

        results.append({
            "Modelo": model_id,
            "Prompt": prompt,
            "Tempo (s)": round(end_time - start_time, 2),
            "Resposta Gerada": clean_response[:150] + "..." # Truncar para visualização
        })
        
    # Limpar memória da GPU para o próximo modelo
    del model
    del tokenizer
    torch.cuda.empty_cache()

# Célula 4: Exibição dos Resultados
df_results = pd.DataFrame(results)
print("\n=== RESULTADOS DA COMPARAÇÃO ===")
display(df_results)

# Opcional: Salvar em CSV para o repositório
df_results.to_csv("benchmark_resultados.csv", index=False)